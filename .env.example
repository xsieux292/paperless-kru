# ---------------------------------------------------------------------------
# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าตามสภาพแวดล้อมจริง
#   cp .env.example .env
# ---------------------------------------------------------------------------

# URL ของ backend — เว้นว่างไว้ = ใช้ข้อมูลจำลอง (mock) ทั้งหมด
# ตัวอย่าง: https://api.school.ac.th/v1
VITE_API_BASE_URL=

# บังคับเปิด/ปิดข้อมูลจำลอง
# ไม่ใส่ = ใช้ mock อัตโนมัติเมื่อ VITE_API_BASE_URL ว่าง
# ตั้ง false เมื่อพร้อมยิง API จริง
VITE_USE_MOCK=

# หมดเวลารอ request (มิลลิวินาที)
VITE_API_TIMEOUT_MS=30000

# ความถี่ในการถามสถานะงานจาก backend (มิลลิวินาที)
VITE_JOB_POLL_INTERVAL_MS=3000

# ข้อจำกัดของไฟล์ (ควรตั้งให้ตรงกับฝั่ง backend)
VITE_MAX_FILE_SIZE_MB=25
VITE_MAX_FILE_COUNT=10

# เบอร์ติดต่อฝ่ายไอทีที่แสดงในกล่องช่วยเหลือ
VITE_SUPPORT_PHONE=02-123-4567
VITE_SUPPORT_PHONE_HREF=021234567
